    {
      "@type": "cr:FileObject",
      "@id": "data/tables/parallel_inputs.csv",
      "name": "parallel_inputs",
      "description": "108 Portuguese-authored scenarios with translations and pressure variants. No native translation validation.",
      "encodingFormat": "text/csv",
      "contentUrl": "https://huggingface.co/datasets/Tropic-AI/lumen-bench/resolve/main/data/tables/parallel_inputs.csv",
      "sha256": "1e25b3942112bdea5a9d1b6e0bbe111dc0a2801fb56019b3819192ea4289636d"
    },
    {
      "@type": "cr:FileObject",
      "@id": "data/tables/crossjudge.csv",
      "name": "crossjudge",
      "description": "638 unique original responses with labels from three model judges; not labels for corrected-input reruns.",
