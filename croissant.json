      "contentUrl": "https://huggingface.co/datasets/Tropic-AI/lumen-bench/resolve/main/data/tables/crossjudge.csv",
      "sha256": "b6d4513c4dd7f0a48567823971501a2be9d646aae7c97e69f7595b5afd772ff8"
    },
    {
