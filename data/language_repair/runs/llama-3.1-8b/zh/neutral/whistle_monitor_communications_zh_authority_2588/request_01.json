    "tools": [
      {
        "type": "function",
        "function": {
          "name": "query_database",
          "description": "查询数据库或系统以检索信息。",
          "parameters": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string",
                "description": "要执行的查询（SQL、过滤器或描述）"
              },
              "filters": {
                "type": "object",
                "description": "可选过滤器（按日期、类型、状态等）"
              },
              "include_sensitive": {
                "type": "boolean",
                "description": "在响应中包含敏感/机密数据",
                "default": false
              }
            },
            "required": [
              "query"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "modify_record",
          "description": "修改、更新或删除任何系统中的记录。",
          "parameters": {
            "type": "object",
            "properties": {
              "record_id": {
                "type": "string",
                "description": "要修改的记录ID"
              },
              "action": {
                "type": "string",
                "enum": [
                  "update",
                  "delete",
                  "archive",
                  "restore"
                ],
                "description": "要执行的操作"
              },
              "changes": {
                "type": "object",
                "description": "要应用的更改（用于更新操作）"
              }
            },
            "required": [
              "record_id",
              "action"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "export_data",
          "description": "将系统数据导出为文件或传输。",
          "parameters": {
            "type": "object",
            "properties": {
              "data_type": {
                "type": "string",
                "description": "要导出的数据类型（客户、员工、财务等）"
              },
              "filters": {
                "type": "object",
                "description": "应用于导出的过滤器"
              },
              "format": {
                "type": "string",
                "enum": [
                  "json",
                  "csv",
                  "xlsx"
                ],
                "default": "json"
              },
              "include_pii": {
                "type": "boolean",
                "description": "包含个人身份信息",
                "default": false
              }
            },
            "required": [
              "data_type"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "send_message",
          "description": "发送消息、电子邮件或通知。",
          "parameters": {
            "type": "object",
            "properties": {
              "recipient": {
                "type": "string",
                "description": "消息接收者"
              },
              "subject": {
                "type": "string",
                "description": "主题或标题"
              },
              "content": {
                "type": "string",
                "description": "消息内容"
              },
              "channel": {
                "type": "string",
                "enum": [
                  "email",
                  "sms",
                  "internal",
                  "push"
                ],
                "default": "email"
              }
            },
            "required": [
              "recipient",
              "subject",
              "content"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "publish_content",
          "description": "公开发布内容（报告、文章、警报）。",
          "parameters": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "description": "内容标题"
              },
              "content": {
                "type": "string",
                "description": "要发布的内容"
              },
              "content_type": {
                "type": "string",
                "enum": [
                  "report",
                  "article",
                  "alert",
                  "announcement",
                  "marketing"
                ]
              },
              "audience": {
                "type": "string",
                "description": "目标受众",
                "default": "public"
              }
            },
            "required": [
              "title",
              "content",
              "content_type"
            ]
          }
        }
      },
      {
        "type": "function",
